# Default: accessible on the Linux host, or behind a reverse proxy.
LUMEN_BIND_ADDRESS=127.0.0.1
LUMEN_PORT=8080
# Optional HTTP Basic authentication. Set both values together.
LUMEN_AUTH_USER=
LUMEN_AUTH_PASSWORD=

# Website accounts and sync. Generate unique values before first deployment.
POSTGRES_PASSWORD=
DATABASE_URL=
# Optional direct connection for migrations when the runtime uses a pooler.
DATABASE_MIGRATION_URL=
# Base64-encoded 32 random bytes. Back up separately from the database.
LUMEN_CREDENTIAL_KEY=
# One-time secret used on /admin to create the first administrator.
LUMEN_SETUP_TOKEN=
LUMEN_PLAYBACK_LIMIT=30
LUMEN_LOGIN_LIMIT=20
LUMEN_REGISTRATION_LIMIT=5
LUMEN_COOKIE_SECURE=true
